<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         version="5.0">

    <display-name>BlueOcean</display-name>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InscriptionServlet</servlet-name>
        <servlet-class>servlet.InscriptionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InscriptionServlet</servlet-name>
        <url-pattern>/inscription</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CaptureServlet</servlet-name>
        <servlet-class>servlet.CaptureServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CaptureServlet</servlet-name>
        <url-pattern>/captures</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GPSServlet</servlet-name>
        <servlet-class>servlet.GPSServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GPSServlet</servlet-name>
        <url-pattern>/gps</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MeteoServlet</servlet-name>
        <servlet-class>servlet.MeteoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MeteoServlet</servlet-name>
        <url-pattern>/meteo</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SignalementServlet</servlet-name>
        <servlet-class>servlet.SignalementServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SignalementServlet</servlet-name>
        <url-pattern>/signalement</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BateauServlet</servlet-name>
        <servlet-class>servlet.BateauServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BateauServlet</servlet-name>
        <url-pattern>/bateau</url-pattern>
    </servlet-mapping>

</web-app>